<Application
    x:Class="HLSDownloader.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFF3F4F6" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SecondaryCardBrush" Color="#FFF8FAFC" />
                    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FFDCE2EA" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF5F6672" />
                    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#FF8A929F" />
                    <SolidColorBrush x:Key="PlaceholderFillBrush" Color="#FFE9EDF2" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FF111318" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF1B1E24" />
                    <SolidColorBrush x:Key="SecondaryCardBrush" Color="#FF242831" />
                    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FF353B46" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFB8C0CC" />
                    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#FF858E9C" />
                    <SolidColorBrush x:Key="PlaceholderFillBrush" Color="#FF2B3039" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
